[Unit]
Description=Polymarket US hourly BTC partition data collector
Wants=network-online.target time-sync.target
After=network-online.target time-sync.target
ConditionPathExists=/etc/polymarket-us/.env.us
StartLimitIntervalSec=0

[Service]
Type=simple
User=polymarket-us
Group=polymarket-us
WorkingDirectory=/opt/polymarket-us/partition-collector/current
ExecStart=/opt/polymarket-us/partition-collector/current/.venv/bin/python -m tools.collect_partition_data --env-file /etc/polymarket-us/.env.us --output /var/lib/polymarket-us/partition-data
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
UMask=0077
Restart=on-failure
RestartSec=15s
KillSignal=SIGINT
TimeoutStopSec=60
MemoryMax=192M
CPUQuota=15%
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/polymarket-us/partition-data
InaccessiblePaths=-/var/lib/polymarket-us/research-data -/var/lib/polymarket-us/us-live.sqlite -/var/lib/polymarket-us/us-live.sqlite-wal -/var/lib/polymarket-us/us-live.sqlite-shm
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
