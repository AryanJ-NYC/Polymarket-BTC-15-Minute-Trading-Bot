[Unit]
Description=Polymarket US BTC bot (live configuration, manual activation)
Wants=network-online.target time-sync.target
After=network-online.target time-sync.target
ConditionPathExists=/etc/polymarket-us/.env.us

[Service]
Type=simple
User=polymarket-us
Group=polymarket-us
WorkingDirectory=/opt/polymarket-us/current
ExecStart=/opt/polymarket-us/current/.venv/bin/python /opt/polymarket-us/current/bot.py --live --env-file /etc/polymarket-us/.env.us --model /var/lib/polymarket-us/model.json
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
UMask=0077
Restart=on-failure
RestartSec=10s
RestartPreventExitStatus=2
KillSignal=SIGINT
TimeoutStopSec=180
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/polymarket-us
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
