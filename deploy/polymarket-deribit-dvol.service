[Unit]
Description=Public Deribit BTC volatility index archive
Wants=network-online.target time-sync.target
After=network-online.target time-sync.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=polymarket-dvol
Group=polymarket-dvol
WorkingDirectory=/opt/polymarket-us/dvol-collector/current
ExecStart=/opt/polymarket-us/dvol-collector/current/.venv/bin/python -m tools.collect_deribit_dvol --output /var/lib/polymarket-deribit-dvol
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
UMask=0077
Restart=on-failure
RestartSec=15s
KillSignal=SIGINT
TimeoutStopSec=60
MemoryMax=128M
CPUQuota=10%
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/polymarket-deribit-dvol
InaccessiblePaths=/etc/polymarket-us /var/lib/polymarket-us /var/lib/polymarket-kraken-quotes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
